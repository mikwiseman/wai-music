SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_CACHE_PATH=~/.config/wai-music/spotify_token.json

WAI_MUSIC_DB_PATH=~/.config/wai-music/cache.sqlite
WAI_MUSIC_PLAYLISTS_DIR=./playlists
WAI_MUSIC_DEFAULT_LANGUAGE=en
WAI_MUSIC_HOST=127.0.0.1
WAI_MUSIC_PORT=8765
WAI_MUSIC_PUBLIC_BASE_URL=
WAI_MUSIC_SECRET_KEY=
WAI_MUSIC_SESSION_COOKIE=wai_music_session
WAI_MUSIC_ENABLE_PERSONAL_ACCESS_TOKENS=false
WAI_MUSIC_SIGNUP_RATE_LIMIT_WINDOW_SECONDS=900
WAI_MUSIC_SIGNUP_RATE_LIMIT_MAX_ATTEMPTS=5
WAI_MUSIC_SIGNIN_RATE_LIMIT_WINDOW_SECONDS=900
WAI_MUSIC_SIGNIN_RATE_LIMIT_MAX_ATTEMPTS=10
WAI_MUSIC_PERSONAL_ACCESS_TOKEN_RATE_LIMIT_WINDOW_SECONDS=3600
WAI_MUSIC_PERSONAL_ACCESS_TOKEN_RATE_LIMIT_MAX_ATTEMPTS=5
WAI_MUSIC_SENTRY_DSN=
WAI_MUSIC_SENTRY_ENVIRONMENT=
WAI_MUSIC_SENTRY_TRACES_SAMPLE_RATE=0.0

MUSICBRAINZ_USER_AGENT=wai-music/0.1 (+https://github.com/mikwiseman/wai-music)
