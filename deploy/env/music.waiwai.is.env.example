SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

WAI_MUSIC_PUBLIC_BASE_URL=https://music.waiwai.is
WAI_MUSIC_SECRET_KEY=replace-with-a-long-random-secret
WAI_MUSIC_HOST=0.0.0.0
WAI_MUSIC_PORT=8000

WAI_MUSIC_DB_PATH=/var/lib/wai-music/cache.sqlite
WAI_MUSIC_PLAYLISTS_DIR=/var/lib/wai-music/playlists
SPOTIFY_CACHE_PATH=/var/lib/wai-music/legacy-spotify-token.json

WAI_MUSIC_DEFAULT_LANGUAGE=en
MUSICBRAINZ_USER_AGENT=wai-music/0.1 (+https://github.com/mikwiseman/wai-music)
