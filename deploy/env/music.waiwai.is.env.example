SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

WAI_MUSIC_PUBLIC_BASE_URL=https://music.waiwai.is
WAI_MUSIC_SECRET_KEY=replace-with-a-long-random-secret
WAI_MUSIC_HOST=0.0.0.0
WAI_MUSIC_PORT=8000
WAI_MUSIC_ENABLE_PERSONAL_ACCESS_TOKENS=false
WAI_MUSIC_MAGIC_LINK_FROM_EMAIL=login@music.waiwai.is
WAI_MUSIC_MAGIC_LINK_TTL_SECONDS=900
WAI_MUSIC_SIGNUP_RATE_LIMIT_WINDOW_SECONDS=900
WAI_MUSIC_SIGNUP_RATE_LIMIT_MAX_ATTEMPTS=5
WAI_MUSIC_SIGNIN_RATE_LIMIT_WINDOW_SECONDS=900
WAI_MUSIC_SIGNIN_RATE_LIMIT_MAX_ATTEMPTS=10
WAI_MUSIC_PERSONAL_ACCESS_TOKEN_RATE_LIMIT_WINDOW_SECONDS=3600
WAI_MUSIC_PERSONAL_ACCESS_TOKEN_RATE_LIMIT_MAX_ATTEMPTS=5
WAI_MUSIC_SENTRY_DSN=
WAI_MUSIC_SENTRY_ENVIRONMENT=production
WAI_MUSIC_SENTRY_TRACES_SAMPLE_RATE=0.1
RESEND_API_KEY=

WAI_MUSIC_DB_PATH=/var/lib/wai-music/cache.sqlite
WAI_MUSIC_PLAYLISTS_DIR=/var/lib/wai-music/playlists
SPOTIFY_CACHE_PATH=/var/lib/wai-music/legacy-spotify-token.json

WAI_MUSIC_DEFAULT_LANGUAGE=en
MUSICBRAINZ_USER_AGENT=wai-music/0.1 (+https://github.com/mikwiseman/wai-music)
